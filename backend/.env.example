PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://stellarwork:stellarwork_dev@localhost:5432/stellarwork
# Required. Server startup fails if JWT_SECRET is unset.
JWT_SECRET=replace-with-a-long-random-secret

# Required before enterprise SAML/OIDC is enabled in production. Exactly 32
# bytes encoded as base64 or 64 hexadecimal characters; keep separate from JWT.
FEDERATION_HASH_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban escrow contract ID (see docs/contract-deployment.md)
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Required in production. Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_WALLET_ADDRESSES=
SERVER_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── CORS ───────────────────────────────────────────────────
# Required in production. Development defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql://stellarwork:stellarwork_dev@localhost:5432/stellarwork

# ── Feed Base URL ───────────────────────────────────────────
BASE_URL=http://localhost:3000

# ── Weekly digest email ─────────────────────────────────────
# Frontend origin embedded in job apply links and the unsubscribe page link
FRONTEND_URL=http://localhost:3000
# Backend origin used to build the unsubscribe endpoint URL in digest emails
API_BASE_URL=http://localhost:4000

# ── Multi-CDN edge strategy & event-driven invalidation (see docs/CDN_STRATEGY.md) ──
# Public origin the CDN fronts — used to build the URLs purged on contract events.
PUBLIC_BASE_URL=http://localhost:3000
# Ordered provider chain; a provider is only used if its credentials below are set.
# Falls back to an in-memory mock provider (dev/CI) when none are configured.
CDN_PROVIDER_ORDER=cloudflare,fastly
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
FASTLY_SERVICE_ID=
FASTLY_API_TOKEN=
# HMAC secret for POST /api/cdn/webhook (external pub-sub invalidation trigger).
# Leave unset in local dev; required in production.
CDN_WEBHOOK_SECRET=

# ── Compliance core (see docs/COMPLIANCE_OPERATIONS.md) ─────
# JSON keyring values are 32-byte base64 or 64-character hex keys. Production
# deployments must inject these through the secret manager/KMS integration.
COMPLIANCE_ENCRYPTION_KEYS={"local":"REPLACE_WITH_32_BYTE_BASE64_KEY"}
COMPLIANCE_ENCRYPTION_KEY_ID=local
COMPLIANCE_BLIND_INDEX_KEY=REPLACE_WITH_AT_LEAST_32_BYTE_BASE64_KEY

KYC_PROVIDER_NAME=
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=
SCREENING_PROVIDER_NAME=
SCREENING_PROVIDER_URL=
SCREENING_PROVIDER_API_KEY=
ONCHAIN_RISK_PROVIDER_NAME=
ONCHAIN_RISK_PROVIDER_URL=
ONCHAIN_RISK_PROVIDER_API_KEY=
TRAVEL_RULE_PROVIDER_NAME=
TRAVEL_RULE_PROVIDER_URL=
TRAVEL_RULE_PROVIDER_API_KEY=
REGULATORY_REPORTING_URL=
REGULATORY_REPORTING_API_KEY=
# Trust these headers only when the edge strips client-supplied values.
COMPLIANCE_TRUSTED_GEO_HEADERS=false
COMPLIANCE_GEO_HEADER_CONFIDENCE=0.95
COMPLIANCE_GEO_AUDIT_KEY=replace-with-a-dedicated-hmac-secret
