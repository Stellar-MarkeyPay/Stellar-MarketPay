{
  "name": "stellar-marketpay-backend",
  "version": "1.0.0",
  "description": "Backend API for Stellar MarketPay",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "test": "jest --coverage",
    "test:unit": "jest",
    "test:chaos": "jest tests/chaos.test.js --verbose --no-coverage",
    "test:sla": "jest src/services/sla_monitor.test.js --verbose",
    "generate-openapi": "node scripts/generate-openapi.js",
    "build": "npm run generate-openapi && npm run lint",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "node src/db/migrate.js down",
    "reindex:job-search": "node scripts/reindex-job-search-vector.js",
    "graphql:schema:write": "node scripts/graphql-schema-registry.js --write",
    "graphql:schema:check": "node scripts/graphql-schema-registry.js --check",
    "graphql:schema:breaking": "node scripts/graphql-schema-registry.js --breaking",
    "clean": "rm -rf node_modules coverage"
  },
  "dependencies": {
    "@marketpay/validation": "workspace:*",
    "@simplewebauthn/server": "^9.0.3",
    "@stellar/stellar-sdk": "^12.0.0",
    "axios": "^1.7.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.3.1",
    "form-data": "^4.0.0",
    "graphql": "^16.14.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.20.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rss": "^1.2.2",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.3.0",
    "jest-openapi": "^0.14.2",
    "nodemon": "^3.1.2",
    "supertest": "^7.2.2",
    "validator": "^13.15.35",
    "xss": "^1.0.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
