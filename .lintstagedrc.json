{
  "frontend/**/*.{js,jsx,ts,tsx}": ["npm --prefix frontend run lint -- --fix", "prettier --write"],
  "backend/**/*.js": ["npm --prefix backend run lint -- --fix", "prettier --write"],
  "contracts/marketpay-contract/**/*.rs": [
    "cargo fmt --manifest-path contracts/marketpay-contract/Cargo.toml --",
    "cargo clippy --manifest-path contracts/marketpay-contract/Cargo.toml -- -D warnings"
  ],
  "*.{json,md,yml,yaml}": ["prettier --write"]
}
