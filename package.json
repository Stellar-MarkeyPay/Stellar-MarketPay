{
  "name": "stellar-marketpay",
  "version": "1.0.0",
  "description": "Decentralised freelance marketplace powered by Stellar blockchain and Soroban smart contracts.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "(cd frontend && npm run lint) && (cd backend && npm run lint)",
    "lint:fix": "(cd frontend && npm run lint -- --fix) && (cd backend && npm run lint -- --fix)",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "(cd frontend && npm run type-check) && (cd backend && npm run type-check)",
    "test": "npm run test:fast",
    "test:fast": "(cd frontend && npm test) && (cd backend && npm run test:unit) && cargo test --manifest-path contracts/marketpay-contract/Cargo.toml --features std",
    "test:frontend": "(cd frontend && npm test)",
    "test:backend": "(cd backend && npm test)",
    "test:contracts": "cargo test --manifest-path contracts/marketpay-contract/Cargo.toml --features std",
    "policy": "node policy/cli.js",
    "policy:check": "node policy/cli.js check --stage pre-push --source range --base auto",
    "policy:ci": "node policy/cli.js check --stage ci --source range --base auto",
    "policy:test": "node --test policy/tests/*.test.js",
    "policy:measure": "node policy/cli.js measure --depth 150",
    "policy:catalogue": "node policy/cli.js catalogue",
    "policy:integrity": "node policy/cli.js integrity",
    "policy:overrides": "node policy/cli.js overrides",
    "policy:signing-setup": "bash scripts/setup-commit-signing.sh",
    "commit": "cz",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:major": "commit-and-tag-version --release-as major",
    "test:hooks": "node --test scripts/hooks/tests/*.test.mjs",
    "hooks:pre-commit": "node scripts/hooks/cli.mjs pre-commit",
    "hooks:pre-push": "node scripts/hooks/cli.mjs pre-push",
    "hooks:doctor": "node scripts/hooks/cli.mjs doctor"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edoscoba/Stellar-MarketPay.git"
  },
  "keywords": [
    "stellar",
    "soroban",
    "freelance",
    "marketplace",
    "smart-contracts"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "commit-and-tag-version": "^13.1.2",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
